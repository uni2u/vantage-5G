              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "ue_ip",
            "desc": false
          }
        ],
        "cellHeight": "sm"
      }
    }

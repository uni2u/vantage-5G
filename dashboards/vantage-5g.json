{
  "title": "Vantage-5G per-UE bandwidth",
  "uid": "vantage-5g",
  "tags": [
    "vantage-5g",
    "ebpf"
  ],
  "description": "Per-UE RX policer / TX EDT pacer: realized throughput vs cap, drops, policy. Metrics: README §7.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "Counter reset (reload / LRU / monitor restart)",
        "expr": "sum by (instance, ue_ip) (resets(vantage_ue_tx_bytes_total{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}[1m]) + resets(vantage_ue_rx_bytes_total{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}[1m])) > 0",
        "step": "60s",
        "titleFormat": "counter reset",
        "textFormat": "{{ue_ip}} on {{instance}}: counters restarted from 0 (rate() unaffected)"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "instance",
        "label": "Exporter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"vantage_ue_.+\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values({__name__=~\"vantage_ue_.+\"}, instance)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0,
        "options": []
      },
      {
        "name": "ue_ip",
        "label": "UE",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"vantage_ue_.+\", instance=~\"$instance\"}, ue_ip)",
          "refId": "ue_ip"
        },
        "definition": "label_values({__name__=~\"vantage_ue_.+\", instance=~\"$instance\"}, ue_ip)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0,
        "options": []
      },
      {
        "name": "rate_window",
        "label": "rate window",
        "type": "custom",
        "description": "rate() range. 15s (default) assumes a scrape interval of 5 s or less (>= 3 scrapes per window). $__rate_interval = max(4 x scrape interval of the data source, step + scrape interval).",
        "query": "5s,10s,15s,30s,1m,5m,$__rate_interval",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "15s",
          "value": "15s"
        },
        "hide": 0,
        "options": [
          {
            "text": "5s",
            "value": "5s",
            "selected": false
          },
          {
            "text": "10s",
            "value": "10s",
            "selected": false
          },
          {
            "text": "15s",
            "value": "15s",
            "selected": true
          },
          {
            "text": "30s",
            "value": "30s",
            "selected": false
          },
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "$__rate_interval",
            "value": "$__rate_interval",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "UEs with a policy",
      "description": "Number of vantage_ue_policy_tx_bps series = entries in ue_policy_map. A `reset` UE disappears from this count (its policy gauges are removed).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(vantage_ue_policy_tx_bps{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Killswitch UEs (TX cap 0)",
      "description": "UEs whose TX cap is 0: all downlink is dropped (counted in tx_drops). Shown here and in the policy table instead of in the cap-ratio panels, where the ratio would divide by 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(vantage_ue_policy_tx_bps{instance=~\"$instance\", ue_ip=~\"$ue_ip\"} == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "UEs with counters but no policy",
      "description": "Stats series without a policy: the UE was `reset` (policy removed, counters frozen because unshaped traffic is not counted) or never had a policy since the stats entry was created. Their traffic is NOT shaped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(max by (instance, ue_ip) (vantage_ue_tx_bytes_total{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}) unless on (instance, ue_ip) vantage_ue_policy_tx_bps) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Exporter scrape",
      "description": "Prometheus `up` of the selected exporter instance(s) in scrape job `vantage-5g` (other jobs, e.g. node_exporter, are ignored): 1 = /metrics reachable. If your scrape job has another job_name, change `job=\"vantage-5g\"` in this query. Vantage series vanish after `unload` even while up = 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "min(up{job=\"vantage-5g\", instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Throughput vs cap",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DL (TX pacer) throughput vs cap",
      "description": "Bytes are L2 frame bytes (Ethernet header included), the same unit the cap is enforced in (contract X3 option B), so realized ≈ cap; iperf3 goodput is a few % lower (L2/L3/L4 headers). Counters restart from 0 when the maps are re-created (unload → load) or an LRU entry is evicted; rate() treats that as a counter reset, so throughput stays correct across it. Dashed = configured TX cap (killswitch UEs with cap 0 are not drawn; see the Killswitch stat).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(vantage_ue_tx_bytes_total{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}[$rate_window]) * 8",
          "legendFormat": "{{ue_ip}} DL",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "vantage_ue_policy_tx_bps{instance=~\"$instance\", ue_ip=~\"$ue_ip\"} > 0",
          "legendFormat": "{{ue_ip}} DL cap",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* cap$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "UL (RX policer) throughput vs cap",
      "description": "Bytes are L2 frame bytes (Ethernet header included), the same unit the cap is enforced in (contract X3 option B), so realized ≈ cap; iperf3 goodput is a few % lower (L2/L3/L4 headers). Counters restart from 0 when the maps are re-created (unload → load) or an LRU entry is evicted; rate() treats that as a counter reset, so throughput stays correct across it. Admitted bytes only (dropped frames are in rx_drops). Dashed = configured RX cap; RX cap 0 means uncapped and is not drawn. In xdpgeneric mode frames are counted after GRO.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8

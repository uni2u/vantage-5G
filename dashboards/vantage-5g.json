    {
      "id": 17,
      "type": "row",
      "title": "Policy",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "table",
      "title": "Per-UE policy and current verdict",
      "description": "One row per (UE, exporter) with a policy (ue_policy_map): every query is aggregated `max by (instance, ue_ip)` and the *Merge* transformation joins them on both labels, so two Vantage nodes with the same UE IP (e.g. Open5GS's default pool 10.45.0.0/16) stay on separate rows. TX cap 0 = KILLSWITCH (all DL dropped), RX cap 0 = uncapped. A `reset` UE disappears from this table (policy gauges removed); its counters, if any, show up in 'UEs with counters but no policy'. Ratios are over the selected rate window; killswitch / uncapped directions show no ratio.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, ue_ip) (vantage_ue_policy_rx_bps{instance=~\"$instance\", ue_ip=~\"$ue_ip\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, ue_ip) (vantage_ue_policy_tx_bps{instance=~\"$instance\", ue_ip=~\"$ue_ip\"})",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, ue_ip) (rate(vantage_ue_rx_bytes_total{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}[$rate_window]) * 8 and on (instance, ue_ip) vantage_ue_policy_rx_bps)",
          "legendFormat": "",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, ue_ip) (rate(vantage_ue_tx_bytes_total{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}[$rate_window]) * 8 and on (instance, ue_ip) vantage_ue_policy_tx_bps)",
          "legendFormat": "",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, ue_ip) (100 * rate(vantage_ue_rx_bytes_total{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}[$rate_window]) * 8 / on (instance, ue_ip) (vantage_ue_policy_rx_bps > 0))",
          "legendFormat": "",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, ue_ip) (100 * rate(vantage_ue_tx_bytes_total{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}[$rate_window]) * 8 / on (instance, ue_ip) (vantage_ue_policy_tx_bps > 0))",
          "legendFormat": "",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, ue_ip) (rate(vantage_ue_tx_drops_total{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}[$rate_window]) and on (instance, ue_ip) vantage_ue_policy_tx_bps)",
          "legendFormat": "",
          "refId": "G",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "RX cap",
              "Value #B": "TX cap",
              "Value #C": "UL now",
              "Value #D": "DL now",
              "Value #E": "UL / cap",
              "Value #F": "DL / cap",
              "Value #G": "DL drops/s",
              "instance": "exporter"
            },
            "indexByName": {
              "ue_ip": 0,
              "instance": 1,
              "Value #A": 2,
              "Value #C": 3,
              "Value #E": 4,
              "Value #B": 5,
              "Value #D": 6,
              "Value #F": 7,
              "Value #G": 8
            },
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "unit": "bps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RX cap"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "uncapped",
                        "color": "blue",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TX cap"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "KILLSWITCH",
                        "color": "red",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",

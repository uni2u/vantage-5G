    {
      "id": 12,
      "type": "row",
      "title": "Drops and packet rate",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "DL drops/s (killswitch + EDT horizon)",
      "description": "Segments the TX pacer dropped: every DL packet of a killswitch UE (TX cap 0), or packets that would be scheduled more than 2 s ahead (EDT horizon: DL offered far above the cap, e.g. a UDP flood). TCP backs off, so a capped TCP UE normally shows ~0. Counters restart from 0 when the maps are re-created (unload → load) or an LRU entry is evicted; rate() treats that as a counter reset, so throughput stays correct across it. ",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(vantage_ue_tx_drops_total{instance=~\"$instance\", ue_ip=~\"$ue_ip\"}[$rate_window])",
          "legendFormat": "{{ue_ip}}",
          "refId": "A",
          "range": true,
          "instant": false

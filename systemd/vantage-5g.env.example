# /etc/vantage-5g/vantage-5g.env -- read by vantage-5g.service and
# vantage-5g-monitor.service (systemd EnvironmentFile syntax: KEY=VALUE).
# After editing: sudo systemctl restart vantage-5g   (re-attaches)

# N6-facing interface of the service node (required; the unit fails while empty).
IFACE=

# XDP attach mode: generic (default, any driver) | native (driver support needed).
# Must not be empty (delete the line to get the default).
XDP_MODE=generic

# Seconds the start waits for IFACE to exist (late NICs, bonds, VLANs, dummies
# created by systemd-networkd). The unit fails with exit 6 after that.
# At most 240 (larger values are clamped): the whole start must fit in the
# unit's TimeoutStartSec=300. For longer, `sudo systemctl edit vantage-5g` and
# raise TimeoutStartSec= together with Environment=IFACE_WAIT_MAX=.
IFACE_WAIT_SEC=90

# Arguments for `vantage-5G monitor` (Prometheus exporter, port 9090 by default).
# WARNING: /metrics lists every UE's IP, policy and byte/drop counters. Without
# --bind the CLI listens on 0.0.0.0, i.e. also on the N6 side where UE traffic
# is routed. Keep 127.0.0.1, or for a remote Prometheus bind the address of the
# management network only (and firewall it), e.g.
#   MONITOR_ARGS=--bind 192.0.2.10 --port 9090
MONITOR_ARGS=--bind 127.0.0.1
